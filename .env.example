# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_TIME_ZONE=Africa/Kigali
DJANGO_SECURE_SSL_REDIRECT=false
OPEDU_RELEASE_VERSION=development
# The frontend build must receive the same immutable release as VITE_RELEASE_VERSION.
VITE_RELEASE_VERSION=development

# Private S3-compatible production media. Prefer workload identity instead of static keys.
OPEDU_REQUIRE_OBJECT_STORAGE=false
OPEDU_OBJECT_STORAGE_BUCKET=
OPEDU_OBJECT_STORAGE_REGION=
OPEDU_OBJECT_STORAGE_ENDPOINT=
OPEDU_OBJECT_STORAGE_PREFIX=media
OPEDU_OBJECT_STORAGE_ACCESS_KEY=
OPEDU_OBJECT_STORAGE_SECRET_KEY=
OPEDU_OBJECT_STORAGE_ENCRYPTION=AES256
OPEDU_OBJECT_STORAGE_KMS_KEY_ID=
OPEDU_MEDIA_URL_EXPIRY_SECONDS=300

# Email for invitations and password resets. Without a host, mail is printed to the log
# (development only; `manage.py check --deploy` warns).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@opedu.local

# Serve Django admin static files from the app server. Turn off if nginx or a CDN serves /static/.
OPEDU_SERVE_STATIC=true

# Reverse proxies in front of Django (1 for the bundled nginx, 2 with a TLS load balancer in
# front of it). Sign-in lockouts and rate limits then use each visitor's own address instead of
# the proxy's, so one school network is not locked out together. Keep 0 when Django is exposed
# directly, or clients could forge X-Forwarded-For.
OPEDU_TRUSTED_PROXY_COUNT=0
# Sign-in limits: failures per address and account, per account from anywhere, per address
# across accounts, within DJANGO_LOGIN_LOCKOUT_SECONDS.
DJANGO_LOGIN_FAILURE_LIMIT=5
DJANGO_LOGIN_ACCOUNT_FAILURE_LIMIT=20
DJANGO_LOGIN_IP_FAILURE_LIMIT=50
DJANGO_LOGIN_LOCKOUT_SECONDS=300

# PostgreSQL and Redis used by Docker Compose
POSTGRES_DB=opedu
POSTGRES_USER=opedu
POSTGRES_PASSWORD=change-this-development-password
DATABASE_URL=postgresql://opedu:change-this-development-password@postgres:5432/opedu
REDIS_URL=redis://redis:6379/0
OPEDU_REQUIRE_REDIS=false

# Optional xAPI LRS delivery. Leave endpoint blank until the institution approves an LRS.
OPEDU_LRS_ENDPOINT=
OPEDU_LRS_KEY=
OPEDU_LRS_SECRET=
OPEDU_LRS_MAX_DELIVERY_ATTEMPTS=5

# Draft research controls. Replace only after institutional approval and retain the old text/version.
OPEDU_RESEARCH_CONSENT_VERSION=opedu-pilot-consent-v1
OPEDU_RESEARCH_CONSENT_STATUS=draft
OPEDU_RESEARCH_RETENTION_DAYS=365
