# OPedu production settings on the VPS. Copy to /opt/opedu/.env (mode 600, owner deploy) and fill
# in. Never commit the real file.

# Public address; its DNS A record must point at the server.
DOMAIN=opedu.izere.work
FRONTEND_URL=https://opedu.izere.work
DJANGO_ALLOWED_HOSTS=opedu.izere.work
DJANGO_CSRF_TRUSTED_ORIGINS=https://opedu.izere.work

# Long random values: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

DJANGO_TIME_ZONE=Africa/Kigali

# Email for invitations and password resets. Without a host, messages go to the backend log and
# administrators share invitation links themselves.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@opedu.izere.work

# Open sign-up and the visitor demo.
OPEDU_OPEN_REGISTRATION=true
OPEDU_DEMO_LESSON_SLUG=battery-inspection-and-diagnosis

# Research consent stays a draft until an institution approves it.
OPEDU_RESEARCH_CONSENT_VERSION=opedu-pilot-consent-v1
OPEDU_RESEARCH_CONSENT_STATUS=draft
OPEDU_RESEARCH_RETENTION_DAYS=365

# Optional xAPI learning record store; leave empty until approved.
OPEDU_LRS_ENDPOINT=
OPEDU_LRS_KEY=
OPEDU_LRS_SECRET=
