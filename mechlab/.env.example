# Example environment variables for mechlab
# Copy this file to .env and fill in secrets for local development.

# Django settings
DJANGO_SECRET_KEY=replace-this-with-a-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional) - e.g. redis://:password@hostname:6379/0
REDIS_URL=redis://127.0.0.1:6379
